# Pinned engine dependencies for reproducible Vertex builds.
#
# Keep these versions in sync with THIRD_PARTY_NOTICES.md and the licenses in
# Resources/Licenses. build-deps.sh verifies every download against the SHA-256
# values below before compiling anything.
#
# The deployment target is also the app's minimum macOS version. Changing it
# requires rebuilding the dependencies, not just changing Info.plist.

VERTEX_DEPS_TARGET="15.0"
VERTEX_DEPS_ARCH="arm64"

LIBTORRENT_VERSION="2.1.2"
LIBTORRENT_URL="https://github.com/arvidn/libtorrent/releases/download/v2.1.2/libtorrent-rasterbar-2.1.2.tar.gz"
LIBTORRENT_SHA256="3362546d9cd71b9e49ee6cac7d3f1f914ce9cdb217c86b63d5b22cbed0334dbc"

OPENSSL_VERSION="3.5.9"
OPENSSL_URL="https://www.openssl.org/source/openssl-3.5.9.tar.gz"
OPENSSL_SHA256="603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a"

BOOST_VERSION="1.92.0"
BOOST_URL="https://archives.boost.io/release/1.92.0/source/boost_1_92_0.tar.gz"
BOOST_SHA256="c4a3b310ddd2472416e091067166b0713be97c63f38c212c484ada022fd296ce"
