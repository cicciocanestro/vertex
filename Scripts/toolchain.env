# Canonical toolchain for release artifacts.
#
# These are not runtime dependencies: they describe the environment that
# produces the canonical DMG in GitHub Actions. Update this file deliberately
# when the runner image or the release toolchain changes, then validate the
# new artifact and its checksum before publishing.
#
# Local builds are allowed to differ (for example Command Line Tools instead
# of full Xcode, or a newer CMake). They are useful for development but are
# not canonical and must not be compared byte-for-byte with a release.

VERTEX_CANONICAL_RUNNER_IMAGE="20260907.0337.1"
VERTEX_CANONICAL_MACOS_VERSION="15.7.9"

# Swift is supplied by this Xcode installation; pinning the Xcode build also
# pins the Swift compiler used for release artifacts.
VERTEX_CANONICAL_XCODE_PATH="/Applications/Xcode_16.4.app"
VERTEX_CANONICAL_XCODE_VERSION="16.4"
VERTEX_CANONICAL_XCODE_BUILD="16F6"
VERTEX_CANONICAL_MACOS_SDK="15.5"

VERTEX_CANONICAL_CMAKE_VERSION="4.4.3"
