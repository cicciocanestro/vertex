# Application identity shared by build.sh, make-dmg.sh, verify-bundle.sh and CI.
#
# These are the only values that define the public artifact:
#   dist/Vertex.app
#   Vertex-<version>-macOS<min>-<arch>.dmg
#
# Scripts/deps.env derives the engine deployment target and architecture from
# this file, so the compiled dependencies and the bundle cannot drift apart.
# Changing the minimum macOS version still requires rebuilding the engine
# dependencies (Scripts/build-deps.sh --force) and validating a new DMG.

VERTEX_APP_NAME="Vertex"
VERTEX_MIN_MACOS="15.0"
VERTEX_ARCH="arm64"
