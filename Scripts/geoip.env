# Offline IPv4/IPv6 country tables used for the peer flags.
#
# Source: DB-IP "IP to Country Lite" (CC BY 4.0), https://db-ip.com
# The CSV is not shipped: Scripts/build-geoip.sh converts it into compact
# binary tables stored in Resources/GeoIP/country-v4.bin.z and country-v6.bin.z.
# The generated files are committed so builds stay offline and reproducible;
# refresh them by bumping GEOIP_VERSION and GEOIP_SHA256 and re-running the script.

GEOIP_VERSION="2026-11"
GEOIP_URL="https://download.db-ip.com/free/dbip-country-lite-${GEOIP_VERSION}.csv.gz"
GEOIP_SHA256="e5c8459d638a272ece7f4d7cfa49dce18d91b4f403f6940ba9249bf0db3781fd"
GEOIP_V4_OUTPUT="Resources/GeoIP/country-v4.bin.z"
GEOIP_V6_OUTPUT="Resources/GeoIP/country-v6.bin.z"
